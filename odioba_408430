        toks.forEach(function (cur, k) {
          // 閉じかっこのすぐ後ろの助詞(「へえ」と)は、行の頭に離れないようにする
          parts.push(/[」』)）]$/.test(cur) && toks[k + 1] && toks[k + 1].length === 1 && /^[ぁ-ん]$/.test(toks[k + 1]) ? cur + '\u2060' : cur);
          acc += cur.length;
          depth += (cur.match(OPEN) || []).length - (cur.match(CLOSE) || []).length;
          if (k < toks.length - 1 && !noBreak[k] && canBreak(cur, toks[k + 1], acc, depth, toks[k - 1])) { parts.push(null); acc = 0; }
        });
        if (parts.indexOf(null) < 0) return;
        var frag = document.createDocumentFragment();
        parts.forEach(function (x) { frag.appendChild(x === null ? document.createElement('wbr') : document.createTextNode(x)); });
        t.parentNode.replaceChild(frag, t);
      });
    }
    var root = document.getElementById('wrap');
    if (!root) return;
    var mo = new MutationObserver(function () {
      if (busy) return;
      busy = true;
      try { phrasify(root); } finally { mo.takeRecords(); busy = false; }
    });
    busy = true; phrasify(root); busy = false;
    mo.observe(root, { childList: true, subtree: true, characterData: true });
  })();
})();
