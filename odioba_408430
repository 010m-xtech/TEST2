<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#e6f4ef">
<title>おぢおば診断 2026</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Dela+Gothic+One&family=Shippori+Mincho+B1:wght@700;800&family=Zen+Maru+Gothic:wght@500;700;900&display=swap" rel="stylesheet">
<style>
/* Layout concept: 総合クリニックの待合室。ECG用紙の方眼の上に、問診票と診断書が乗る。
   色は「病院のミント × 信号の赤 × 注意のカラシ」。見出しだけ極太ゴシックで遊ぶ。 */
:root {
  color-scheme: light;
  --bg: #DDEEE9;
  --grid: rgba(17, 35, 58, .06);
  --grid-major: rgba(17, 35, 58, .11);
  --paper: #FBFDFC;
  --paper-2: #EAF4F0;
  --ink: #11233A;
  --ink-soft: #44596B;
  --line: #A9C9C0;
  --teal: #12786C;
  --on-teal: #FFFFFF;
  --mustard: #F0B429;
  --on-mustard: #11233A;
  --red: #D3302A;
  --on-red: #FFFFFF;
  --shadow: #11233A;
  --g-a: #2F9E8F;
  --g-b: #8BBE4E;
  --g-c: #F0B429;
  --g-d: #EC7D2E;
  --g-e: #D3302A;
  --font-display: "Dela Gothic One", "Zen Maru Gothic", "Hiragino Maru Gothic ProN", "Hiragino Sans", "Yu Gothic", sans-serif;
  --font-body: "Zen Maru Gothic", "Hiragino Maru Gothic ProN", "Hiragino Sans", "Yu Gothic", "Meiryo", sans-serif;
  --font-seal: "Shippori Mincho B1", "Hiragino Mincho ProN", "Yu Mincho", serif;
}

* { box-sizing: border-box; }
[hidden] { display: none !important; }
html { -webkit-text-size-adjust: 100%; }
body {
  background-color: var(--bg);
  background-image:
    linear-gradient(var(--grid-major) 1px, transparent 1px),
    linear-gradient(90deg, var(--grid-major) 1px, transparent 1px),
    linear-gradient(var(--grid) 1px, transparent 1px),
    linear-gradient(90deg, var(--grid) 1px, transparent 1px);
  background-size: 120px 120px, 120px 120px, 24px 24px, 24px 24px;
  color: var(--ink);
  font-family: var(--font-body);
  font-size: 19px;
  line-height: 1.7;
  font-weight: 500;
  margin: 0;
  padding-block: 16px 48px;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
}
.wrap { max-width: 760px; margin: 0 auto; }
.wrap.z1 { zoom: 1.15; }
.wrap.z2 { zoom: 1.3; }
button, input { font: inherit; color: inherit; }
button { cursor: pointer; -webkit-tap-highlight-color: transparent; }
:focus-visible { outline: 3px solid var(--teal); outline-offset: 3px; }

/* ---- clinic bar ---- */
.clinic-bar {
  display: flex; justify-content: space-between; align-items: center;
  gap: 8px 16px; flex-wrap: wrap; margin-bottom: 16px;
  font-size: 15px; font-weight: 900; letter-spacing: .04em;
}
.brand { display: inline-flex; align-items: center; gap: 10px; min-width: 0; }
.brand svg { width: 30px; height: 30px; flex: none; }
.brand .cross-bg { fill: var(--teal); }
.brand .cross-fg { fill: var(--on-teal); }
.bar-right { display: inline-flex; align-items: center; gap: 12px; flex-wrap: wrap; }
.today { font-variant-numeric: tabular-nums; color: var(--ink-soft); }
.size-btn {
  min-height: 44px; padding: 2px 16px; border: 2px solid var(--ink); border-radius: 999px;
  background: var(--paper); font-weight: 900; font-size: 15px; box-shadow: 0 3px 0 var(--ink);
}
.size-btn:active { transform: translateY(2px); box-shadow: 0 1px 0 var(--ink); }

/* ---- paper ---- */
.paper {
  background: var(--paper);
  border: 2px solid var(--ink);
  border-radius: 10px;
  box-shadow: 6px 6px 0 var(--shadow);
  padding: clamp(18px, 4.4vw, 34px);
  position: relative;
}
.screen.enter { animation: enter .32s ease-out both; }
@keyframes enter { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

.label { font-size: 14px; font-weight: 900; letter-spacing: .14em; color: var(--ink-soft); }
.tag {
  display: inline-block; background: var(--mustard); color: var(--on-mustard);
  font-weight: 900; font-size: 16px; padding: 1px 14px; border-radius: 999px;
  border: 2px solid var(--ink); transform: rotate(-2.5deg); letter-spacing: .06em;
}

/* ---- start ---- */
h1 {
  font-family: var(--font-display); font-weight: 400;
  font-size: clamp(38px, 10.5vw, 68px); line-height: 1.15; margin: 14px 0 10px;
  text-wrap: balance; letter-spacing: -.01em; white-space: nowrap;
}
h1 .hl { background: linear-gradient(transparent 62%, var(--mustard) 62%, var(--mustard) 92%, transparent 92%); padding: 0 .08em; }
.lead { margin: 0 0 6px; font-size: clamp(13px, 4.2vw, 21px); }
.lead .ln { display: block; white-space: nowrap; }
.ecg { display: block; width: 100%; height: auto; margin: 6px 0 18px; overflow: visible; }
.ecg path { fill: none; stroke: var(--red); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 100; stroke-dashoffset: 0; }
@media (prefers-reduced-motion: no-preference) {
  .ecg path { animation: ecg 3.4s linear infinite; }
}
@keyframes ecg {
  0% { stroke-dashoffset: 100; opacity: 1; }
  68% { stroke-dashoffset: 0; opacity: 1; }
  100% { stroke-dashoffset: 0; opacity: 0; }
}
.ticket {
  background: var(--paper-2); border: 2px dashed var(--ink-soft); border-radius: 10px;
  padding: clamp(14px, 3.4vw, 22px); display: grid; gap: 12px;
}
.start-btns { display: grid; gap: 14px; }
.start-btn { min-height: 76px; font-size: clamp(21px, 5.2vw, 26px); }

.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  min-height: 64px; padding: 8px 22px; border: 2px solid var(--ink); border-radius: 10px;
  font-weight: 900; font-size: 20px; letter-spacing: .04em; line-height: 1.3;
  background: var(--paper); transition: transform .08s ease, box-shadow .08s ease;
}
.btn-primary { background: var(--teal); color: var(--on-teal); box-shadow: 0 5px 0 var(--ink); }
.btn-primary:active:not(:disabled) { transform: translateY(3px); box-shadow: 0 2px 0 var(--ink); }
.btn-ghost { box-shadow: 0 4px 0 var(--ink); }
.btn-ghost:active:not(:disabled) { transform: translateY(2px); box-shadow: 0 2px 0 var(--ink); }
.btn-warm { background: var(--mustard); color: var(--on-mustard); box-shadow: 0 5px 0 var(--ink); }
.btn-warm:active:not(:disabled) { transform: translateY(3px); box-shadow: 0 2px 0 var(--ink); }
.btn:disabled { opacity: .4; cursor: not-allowed; box-shadow: none; }
.btn.block { width: 100%; }
.facts { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0 0; padding: 0; list-style: none; font-size: 15px; font-weight: 900; }
.facts li { border: 2px solid var(--ink); border-radius: 999px; padding: 0 14px; background: var(--paper); }

.honest { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; margin: 8px 0 4px; padding: 8px 14px; border-left: 6px solid var(--red); background: var(--paper-2); border-radius: 4px 10px 10px 4px; font-weight: 900; font-size: clamp(17px, 4.2vw, 20px); line-height: 1.6; text-wrap: pretty; }
.honest b { color: var(--red); font-family: var(--font-seal); letter-spacing: .12em; }

/* ---- お店の処方薬(結果) ---- */
.shop-rx { margin-top: 16px; padding: 12px 16px 14px; background: var(--mustard); color: var(--on-mustard); border: 2px solid var(--ink); border-radius: 10px; box-shadow: 4px 4px 0 var(--shadow); }
.shop-rx-head { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 10px; font-weight: 900; font-size: 16px; }
.rxmark { font-family: var(--font-seal); font-weight: 800; font-size: 17px; border: 2px solid currentColor; border-radius: 6px; padding: 0 7px; line-height: 1.4; }
.shop-rx-shop { margin-left: auto; font-size: 14px; letter-spacing: .06em; }
.shop-rx-name { margin: 4px 0 2px; font-family: var(--font-body); font-weight: 900; letter-spacing: .02em; font-size: clamp(24px, 6.6vw, 34px); line-height: 1.3; text-wrap: balance; }
.shop-rx-note { margin: 0; font-weight: 700; text-wrap: pretty; }
.shop-rx-note:empty, .shop-rx-order:empty { display: none; }
.shop-rx-order { margin: 6px 0 0; font-size: 14px; font-weight: 700; opacity: .85; }
.shop-rx-body { display: flex; align-items: center; gap: 14px; margin-top: 8px; }
.shop-rx-text { min-width: 0; flex: 1; }
.shop-rx-body .shop-rx-name { margin-top: 0; }
.shop-rx-photo { flex: none; display: block; width: clamp(96px, 28vw, 140px); max-width: 100%; aspect-ratio: 1; object-fit: cover; border: 2px solid var(--ink); border-radius: 8px; background: var(--paper); }

/* ---- 自己申告 ---- */
.self-title { font-size: clamp(25px, 6.4vw, 34px); font-weight: 900; line-height: 1.5; margin: 14px 0 4px; text-wrap: balance; }
.self-sub { margin: 0; color: var(--ink-soft); font-weight: 700; }
.self-big { text-align: center; font-family: var(--font-display); font-size: clamp(80px, 24vw, 132px); line-height: 1.1; margin: 10px 0 0; font-variant-numeric: tabular-nums; }
.self-big small { font-size: .4em; margin-left: 4px; }
.self-opts { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; margin-top: 6px; }
.self-opt { min-height: 64px; padding: 0; border: 3px solid var(--ink); border-radius: 12px; background: var(--paper); color: var(--ink); font: inherit; font-size: clamp(17px, 5vw, 22px); font-weight: 900; box-shadow: 0 3px 0 var(--ink); cursor: pointer; }
.self-opt:active { transform: translateY(2px); box-shadow: 0 1px 0 var(--ink); }
.self-opt[aria-pressed="true"] { background: var(--teal); color: var(--on-teal); }
.self-scale { display: flex; justify-content: space-between; font-size: 15px; font-weight: 900; color: var(--ink-soft); margin: 8px 0 22px; }
input[type="range"] { display: block; width: 100%; min-width: 0; height: 48px; margin: 0; -webkit-appearance: none; appearance: none; background: transparent; cursor: pointer; }
input[type="range"]::-webkit-slider-runnable-track { box-sizing: border-box; height: 20px; border: 2px solid var(--ink); border-radius: 999px; background: linear-gradient(90deg, var(--g-a), var(--g-b), var(--g-c), var(--g-d), var(--g-e)); }
input[type="range"]::-webkit-slider-thumb { -webkit-appearance: none; box-sizing: border-box; width: 42px; height: 42px; margin-top: -12px; border-radius: 50%; background: var(--paper); border: 3px solid var(--ink); box-shadow: 0 3px 0 var(--ink); }
input[type="range"]::-moz-range-track { box-sizing: border-box; height: 20px; border: 2px solid var(--ink); border-radius: 999px; background: linear-gradient(90deg, var(--g-a), var(--g-b), var(--g-c), var(--g-d), var(--g-e)); }
input[type="range"]::-moz-range-thumb { box-sizing: border-box; width: 42px; height: 42px; border-radius: 50%; background: var(--paper); border: 3px solid var(--ink); box-shadow: 0 3px 0 var(--ink); }
.self-nav { display: flex; gap: 12px; }
.self-nav .btn-primary { flex: 1; }
.self-nav .btn-ghost { min-width: 104px; }

/* ---- quiz ---- */
.quiz-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
.dept { display: inline-flex; align-items: center; gap: 8px; font-weight: 900; font-size: 15px; }
.dept b { background: var(--mustard); color: var(--on-mustard); border: 2px solid var(--ink); border-radius: 6px; padding: 0 10px; font-size: 17px; }
.count { font-family: var(--font-display); font-size: 26px; font-variant-numeric: tabular-nums; }
.ticks { display: flex; gap: 6px; margin-bottom: 24px; }
.ticks i { flex: 1; height: 14px; border: 2px solid var(--ink); border-radius: 3px; background: var(--paper); }
.ticks i.done { background: var(--teal); }
.ticks i.cur { background: var(--mustard); }
.qbox.enter { animation: enter .26s ease-out both; }
.qtext.wrapfb { text-wrap: balance; }
.qtext .ln { display: block; width: max-content; white-space: nowrap; }
.fixed-lines { white-space: nowrap !important; text-wrap: nowrap !important; }
.fixed-lines .ln { white-space: nowrap !important; }
.honest .lines { display: inline-block; }
.karte b { display: block; margin-bottom: 2px; }
.note p, .gloss span, .loading .msg { text-wrap: balance; }
.qtext { font-size: clamp(24px, 6vw, 34px); font-weight: 900; line-height: 1.5; margin: 0 0 22px; text-wrap: pretty; min-height: 3em; }
.gloss { display: grid; gap: 2px; margin: 14px 0 0; padding: 10px 14px; background: var(--paper-2); border-left: 6px solid var(--mustard); border-radius: 4px 10px 10px 4px; font-size: 17px; font-weight: 700; line-height: 1.6; text-wrap: pretty; }
.gloss b { font-size: 14px; letter-spacing: .14em; color: var(--ink-soft); }
.answers { display: grid; grid-template-columns: 1fr; gap: 12px; }
.ans-unk { border-style: dashed; }
.ans {
  display: flex; align-items: center; gap: 14px; min-height: 72px; padding: 10px 16px; text-align: left;
  background: var(--paper); border: 2px solid var(--ink); border-radius: 10px;
  font-weight: 900; font-size: clamp(20px, 5vw, 24px); line-height: 1.35;
  transition: transform .08s ease, background .12s ease;
}
.ans:hover { background: var(--paper-2); }
.ans:active { transform: translateY(2px); }
.ans .dot { width: 28px; height: 28px; flex: none; border: 2px solid currentColor; border-radius: 50%; display: grid; place-items: center; font-size: 16px; font-weight: 900; line-height: 1; }
.ans .qmark { margin-left: auto; font-family: var(--font-display); font-size: 24px; line-height: 1; opacity: .6; }
.ans[aria-pressed="true"] { background: var(--teal); color: var(--on-teal); }
.ans[aria-pressed="true"] .dot { background: var(--on-teal); color: var(--teal); }
.ans[aria-pressed="true"] .dot::after { content: "✓"; }
.note {
  margin-top: 18px; min-height: 5.6em; display: flex; gap: 12px; align-items: flex-start;
  border: 2px dashed var(--ink-soft); border-radius: 10px; padding: 12px 14px; background: var(--paper-2);
}
.note .who { flex: none; background: var(--ink); color: var(--paper); font-size: 14px; font-weight: 900; border-radius: 6px; padding: 0 8px; margin-top: 3px; letter-spacing: .06em; }
.note p { margin: 0; font-size: 17px; line-height: 1.65; }
.note p.empty { color: var(--ink-soft); }
.note.pop p { animation: pop .3s ease-out; }
@keyframes pop { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
.nav { display: flex; gap: 12px; margin-top: 22px; }
.nav .btn-primary { flex: 1; }
.nav .btn-ghost { min-width: 124px; border-width: 3px; font-weight: 900; }
.fine { margin: 16px 0 0; font-size: 14px; color: var(--ink-soft); }

/* ---- loading ---- */
.loading { text-align: center; padding-block: 28px; }
.loading h2 { font-family: var(--font-display); font-weight: 400; font-size: clamp(26px, 6.5vw, 40px); margin: 6px 0; }
.loading .msg { min-height: 2em; font-weight: 700; color: var(--ink-soft); margin: 0; }
.board { margin: 14px auto 8px; max-width: 340px; padding: 10px 18px 12px; background: var(--ink); color: var(--paper); border-radius: 10px; }
.board .cap { font-size: 14px; font-weight: 900; letter-spacing: .14em; opacity: .85; }
.board .no { font-family: var(--font-display); font-size: clamp(48px, 14vw, 68px); line-height: 1.15; letter-spacing: .12em; font-variant-numeric: tabular-nums; }
.board .in { font-size: 15px; font-weight: 900; letter-spacing: .06em; }
@media (prefers-reduced-motion: no-preference) {
  .board .in { animation: blink 1.2s steps(2, jump-none) infinite; }
}
@keyframes blink { 0% { opacity: 1; } 100% { opacity: .35; } }

/* ---- result(1画面で読み切れる量に) ---- */
.confetti { position: absolute; inset: 0; overflow: hidden; pointer-events: none; border-radius: 8px; }
.confetti i { position: absolute; top: -20px; width: 10px; height: 16px; border-radius: 2px; opacity: 0; animation: fall 3.2s ease-in both; }
@keyframes fall {
  0% { transform: translateY(0) rotate(0deg); opacity: 1; }
  85% { opacity: 1; }
  100% { transform: translateY(720px) rotate(560deg); opacity: 0; }
}
.r-head { text-align: center; border-bottom: 3px double var(--ink); padding-bottom: 8px; }
.r-clinic { font-size: 15px; font-weight: 900; letter-spacing: .12em; color: var(--teal); line-height: 1.4; }
.r-head h2 { font-family: var(--font-seal); font-weight: 800; font-size: clamp(22px, 5.6vw, 30px); margin: 2px 0 8px; line-height: 1.3; letter-spacing: .1em; }
.r-meta { display: flex; justify-content: space-between; align-items: baseline; gap: 4px 12px; font-size: 14px; font-weight: 700; text-align: left; line-height: 1.5; font-variant-numeric: tabular-nums; }
.banner {
  margin: 14px 0 0; padding: 8px 14px; border: 2px solid var(--ink); border-radius: 8px; text-align: center;
  font-family: var(--font-seal); font-weight: 800; font-size: clamp(17px, 4.6vw, 24px); line-height: 1.55;
  letter-spacing: .06em; white-space: pre-line; text-wrap: balance;
}
.banner.A { background: var(--paper-2); color: var(--teal); border-color: var(--teal); }
.banner.E { background: var(--mustard); color: var(--on-mustard); border: 5px double var(--ink); }
.verdict-top { display: flex; align-items: center; gap: 16px; margin-top: 16px; }
.verdict-top .vt { min-width: 0; }
.stamp {
  flex: none; width: 88px; height: 88px; border-radius: 50%; border: 4px double var(--red); color: var(--red);
  display: grid; place-content: center; text-align: center; font-family: var(--font-seal); font-weight: 800;
  transform: rotate(-14deg); opacity: 0;
}
.stamp.on { opacity: 1; }
@media (prefers-reduced-motion: no-preference) {
  .stamp.on { animation: stampIn .5s cubic-bezier(.2, 1.5, .4, 1) both; }
}
@keyframes stampIn { from { opacity: 0; transform: rotate(-14deg) scale(2.6); } to { opacity: 1; transform: rotate(-14deg) scale(1); } }
.stamp small { font-size: 14px; letter-spacing: .2em; line-height: 1.2; }
.stamp b { font-size: 44px; line-height: 1; }
.verdict-top .sub { font-family: var(--font-seal); font-weight: 800; font-size: 18px; line-height: 1.4; margin: 0; color: var(--ink-soft); }
.verdict-top h3 { font-family: var(--font-display); font-weight: 400; font-size: clamp(28px, 7.4vw, 44px); line-height: 1.25; margin: 2px 0 6px; text-wrap: balance; }
.nick { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin: 0; }
.nick b { background: var(--mustard); color: var(--on-mustard); border: 2px solid var(--ink); border-radius: 999px; padding: 0 14px; font-size: clamp(17px, 4.4vw, 21px); }

.meter { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 4px 16px; margin: 6px auto 0; max-width: 520px; }
.gauge-box { min-width: 0; }
.gauge { display: block; width: 100%; height: auto; overflow: visible; }
.gauge .seg { fill: none; stroke-width: 24; }
.seg0 { stroke: var(--g-a); } .seg1 { stroke: var(--g-b); } .seg2 { stroke: var(--g-c); } .seg3 { stroke: var(--g-d); } .seg4 { stroke: var(--g-e); }
.gauge .gl { fill: var(--ink-soft); font-family: var(--font-display); font-size: 15px; text-anchor: middle; dominant-baseline: central; }
.gauge .gl.cur { fill: var(--ink); font-size: 22px; }
.gauge #needle path:first-child { fill: url(#gNeedle); }
.gauge .hub { }
.gauge .hub-dot { fill: var(--mustard); }
.pct { text-align: center; padding-bottom: 6px; }
.pct .cap { font-weight: 900; font-size: 15px; letter-spacing: .08em; line-height: 1.3; }
.pct .num { font-family: var(--font-display); font-size: clamp(52px, 15vw, 84px); line-height: 1.05; font-variant-numeric: tabular-nums; }
.pct .num small { font-size: .42em; margin-left: 2px; }
.pct .bar { height: 8px; margin: 2px auto 0; border-radius: 999px; background: var(--line); overflow: hidden; }
.pct .bar i { display: block; height: 100%; width: 0; background: var(--ink); transition: width 1.5s cubic-bezier(.2, .8, .2, 1); }
@media (max-width: 420px) {
  .meter { grid-template-columns: 1fr; justify-items: center; }
  .gauge-box { width: 100%; max-width: 330px; }
}
.r-body { margin: 12px 0 0; text-wrap: pretty; }

.gapcard { margin-top: 16px; border: 2px solid var(--ink); border-radius: 10px; padding: 12px 14px; background: var(--paper-2); }
.gap-line { display: flex; align-items: center; justify-content: center; gap: 6px 14px; flex-wrap: wrap; }
.gap-tile { text-align: center; line-height: 1.2; }
.gap-tile small { display: block; font-size: 14px; font-weight: 900; color: var(--ink-soft); letter-spacing: .08em; }
.gap-tile b { font-family: var(--font-display); font-weight: 400; font-size: clamp(30px, 8vw, 40px); font-variant-numeric: tabular-nums; }
.gap-arrow { font-family: var(--font-display); font-size: 26px; }
.gap-badge { background: var(--mustard); color: var(--on-mustard); border: 2px solid var(--ink); border-radius: 999px; padding: 0 14px; font-weight: 900; font-size: clamp(18px, 4.6vw, 22px); font-variant-numeric: tabular-nums; }
.gap-msg { margin: 8px 0 0; text-align: center; font-weight: 700; text-wrap: balance; }

.rx1 { margin: 14px 0 0; padding: 10px 14px; border-left: 6px solid var(--teal); background: var(--paper-2); border-radius: 4px 10px 10px 4px; font-weight: 700; text-wrap: pretty; }
.rx1 b { margin-right: .6em; font-family: var(--font-seal); font-weight: 800; letter-spacing: .1em; }

.more { margin-top: 18px; }
.more summary {
  list-style: none; cursor: pointer; min-height: 52px; display: flex; align-items: center; justify-content: center;
  border: 2px solid var(--ink); border-radius: 10px; background: var(--paper); font-weight: 900; box-shadow: 0 3px 0 var(--ink);
}
.more summary::-webkit-details-marker { display: none; }
.more summary::after { content: "＋"; margin-left: 10px; }
.more[open] summary::after { content: "－"; }
.more[open] summary { box-shadow: none; }
.more-body { padding-top: 6px; }
.block-title { display: flex; align-items: center; gap: 10px; margin: 20px 0 10px; font-family: var(--font-seal); font-weight: 800; font-size: 20px; letter-spacing: .1em; }
.block-title::after { content: ""; flex: 1; height: 2px; background: var(--ink); opacity: .25; }
.lab { border: 2px solid var(--ink); border-radius: 8px; overflow: hidden; }
.lab-row { display: grid; grid-template-columns: minmax(0, 1fr) 5.6em 2.6em; align-items: center; gap: 8px; padding: 8px 12px; border-top: 1px solid var(--line); }
.lab-row:first-child { border-top: 0; }
.lab-head { background: var(--ink); color: var(--paper); font-size: 14px; font-weight: 900; letter-spacing: .1em; padding-block: 4px; }
.lab-head span:nth-child(2) { text-align: right; }
.lab-head span:nth-child(3) { text-align: center; }
.lab-name { min-width: 0; }
.lab-name b { display: block; font-size: 17px; line-height: 1.4; }
.lab-name small { display: block; font-size: 14px; color: var(--ink-soft); font-weight: 700; line-height: 1.4; }
.lab-val { text-align: right; font-variant-numeric: tabular-nums; line-height: 1.2; }
.lab-val b { display: block; font-family: var(--font-display); font-weight: 400; font-size: 26px; }
.lab-val small { font-size: 14px; color: var(--ink-soft); font-weight: 700; }
.lab-flag { text-align: center; }
.lab-flag span { display: inline-grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; font-weight: 900; font-size: 17px; }
.flag-H { background: var(--red); color: var(--on-red); }
.flag-L { background: var(--teal); color: var(--on-teal); }
.flag-ok { color: var(--ink-soft); }
.lab-row.fH, .lab-row.fL { background: var(--paper-2); }
.chief { margin: 0; padding: 12px 14px; background: var(--paper-2); border-left: 6px solid var(--red); border-radius: 4px 10px 10px 4px; font-weight: 700; text-wrap: pretty; }
.chief small .nw, .nw { white-space: nowrap; }
.chief small { display: block; color: var(--ink-soft); font-size: 15px; margin-top: 4px; }
.karte { margin: 14px 0 0; padding: 10px 14px; border: 2px dashed var(--ink-soft); border-radius: 8px; font-family: var(--font-seal); font-weight: 700; font-size: 17px; line-height: 1.7; text-wrap: pretty; }
.karte b { font-weight: 800; letter-spacing: .1em; margin-right: .5em; }
.doctor { display: flex; align-items: center; justify-content: flex-end; gap: 10px; flex-wrap: wrap; margin: 16px 0 0; font-family: var(--font-seal); font-weight: 800; font-size: 18px; }
.hanko { display: inline-grid; place-items: center; width: 34px; height: 34px; border: 2px solid var(--red); border-radius: 50%; color: var(--red); font-style: normal; font-size: 16px; transform: rotate(-8deg); }

.actions { display: grid; gap: 8px; margin-top: 22px; }
.actions .hint { margin: 0; text-align: center; font-size: 15px; font-weight: 700; color: var(--ink-soft); }
.disclaimer { margin: 16px 0 0; font-size: 14px; color: var(--ink-soft); line-height: 1.6; }

@media (max-width: 420px) {
  .lab-row { grid-template-columns: minmax(0, 1fr) 4.8em 2.4em; padding-inline: 8px; }
  .lab-val b { font-size: 22px; }
  .lab-name b { font-size: 15px; }
  .stamp { width: 78px; height: 78px; }
  .stamp b { font-size: 38px; }
  .verdict-top { gap: 12px; }
}
@media (prefers-reduced-motion: reduce) {
  .screen.enter, .qbox.enter, .note.pop p { animation: none; }
  .pct .bar i { transition: none; }
}

/* ---- スマホ最適化 ---- */
.nb { display: inline-block; }
html { overflow-x: hidden; }
body { word-break: keep-all; }
body { overflow-wrap: anywhere; -webkit-tap-highlight-color: transparent; }
button, summary { touch-action: manipulation; }
img, svg { max-width: 100%; }
@media (max-width: 400px) {
  body { font-size: 18px; }
  .clinic-bar { font-size: 14px; }
  .qtext { font-size: clamp(21px, 5.8vw, 26px); margin-bottom: 16px; }
  .ans { min-height: 68px; gap: 10px; padding: 8px 12px; }
  .shop-rx-name { font-size: clamp(21px, 6.2vw, 26px); }
  .verdict-top h3 { font-size: clamp(24px, 7vw, 32px); }
}

/* ---- スマホ: なるべくスクロール不要に(各画面を1画面に収める) ---- */
