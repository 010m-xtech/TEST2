      var w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null), nodes = [], n;
      while ((n = w.nextNode())) {
        var p = n.parentNode;
        if (!p || SKIP[p.nodeName] || (p.classList && (p.classList.contains('ln') || p.classList.contains('nw'))) || !/[\u3040-\u30ff\u4e00-\u9fff]{2}/.test(n.nodeValue)) continue;
        nodes.push(n);
      }
      nodes.forEach(function (t) {
        var parts = [], toks = Array.from(seg.segment(t.nodeValue)).map(function (s) { return s.segment; });
        var text = t.nodeValue, offs = [], o = 0, noBreak = [];
        toks.forEach(function (x) { offs.push(o); o += x.length; });
        var KEEP = /お[ぢじ]さん|おばさん|お[ぢじ]おば|おぢ川|おば山|だしまき玉子|沖縄そば|島唐辛子|紅芋/g, km;
        while ((km = KEEP.exec(text))) {
