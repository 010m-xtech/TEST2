            <g id="gNums"></g>
            <text class="g-brand" x="170" y="137">NANPU CLINIC</text>
            <g id="gSegs"></g>
            <g id="gLetters"></g>

            <!-- 針 -->
            <g id="needleSh" transform="translate(3 5) rotate(4 170 160)" filter="url(#gBlur)"><path d="M184 160 L170 151.5 L48 160 L170 168.5 Z" fill="rgba(17,35,58,.42)"/><circle cx="181" cy="160" r="7" fill="rgba(17,35,58,.42)"/></g>
            <g id="needle" transform="rotate(4 170 160)">
              <path d="M184 160 L170 151.5 L48 160 L170 168.5 Z"/>
              <path d="M170 152.6 L50 160 L170 160 Z" fill="rgba(255,255,255,.2)"/>
              <circle cx="181" cy="160" r="7" fill="#13263D"/><circle cx="181" cy="160" r="7" fill="none" stroke="rgba(255,255,255,.25)" stroke-width="1"/>
