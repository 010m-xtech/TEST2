  } catch (e) { return; }

  var COL_TOP = [0.07, 0.47, 0.42], COL_BOT = [0.94, 0.71, 0.16];
  var GRAIN_COLS = [[0.18,0.62,0.56],[0.55,0.75,0.31],[0.94,0.71,0.16],[0.93,0.49,0.18],[0.83,0.19,0.16],[0.98,0.98,0.96]];
  var grains = [];
  for (var g = 0; g < 22; g++) {
    var ang = Math.random() * Math.PI * 2, el = (Math.random() - 0.3) * 1.4;
    grains.push({ d: [Math.cos(ang) * Math.cos(el), Math.sin(el) + 0.5, Math.sin(ang) * Math.cos(el)], sp: 0.9 + Math.random() * 1.1,
      c: GRAIN_COLS[g % GRAIN_COLS.length], s: 0.7 + Math.random() * 0.7 });
  }

  function draw(mesh, M, col, useTex, alpha, V, P, eye, texo, tcol) {
    gl.useProgram(main);
    gl.bindBuffer(gl.ARRAY_BUFFER, mesh.p); gl.enableVertexAttribArray(loc.p); gl.vertexAttribPointer(loc.p, 3, gl.FLOAT, false, 0, 0);
    gl.bindBuffer(gl.ARRAY_BUFFER, mesh.n); gl.enableVertexAttribArray(loc.n); gl.vertexAttribPointer(loc.n, 3, gl.FLOAT, false, 0, 0);
    gl.bindBuffer(gl.ARRAY_BUFFER, mesh.uv); gl.enableVertexAttribArray(loc.uv); gl.vertexAttribPointer(loc.uv, 2, gl.FLOAT, false, 0, 0);
    gl.uniformMatrix4fv(loc.M, false, M); gl.uniformMatrix4fv(loc.V, false, V); gl.uniformMatrix4fv(loc.P, false, P);
    gl.uniform3fv(loc.col, col); gl.uniform3fv(loc.eye, eye); gl.uniform1f(loc.useTex, useTex); gl.uniform1f(loc.alpha, alpha);
    gl.activeTexture(gl.TEXTURE0); gl.bindTexture(gl.TEXTURE_2D, texo || texObj); gl.uniform1i(loc.tex, 0); gl.uniform3fv(loc.tcol, tcol || [1, 1, 1]);
    gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, mesh.i); gl.drawElements(gl.TRIANGLES, mesh.count, gl.UNSIGNED_SHORT, 0);
  }

  var raf = 0, t0 = 0, dur = 2400, running = false, W = 0, H = 0;
  function resize() {
    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    var w = Math.round(canvas.clientWidth * dpr), h = Math.round(canvas.clientHeight * dpr);
    if (w && h && (w !== W || h !== H)) { canvas.width = W = w; canvas.height = H = h; }
  }
  function ease(x) { return x < 0 ? 0 : x > 1 ? 1 : 1 - Math.pow(1 - x, 3); }

  function frame(now) {
    if (!running) return;
    resize();
    var el = (now - t0) / 1000, u = Math.min((now - t0) / dur, 1);
    gl.viewport(0, 0, W, H);
    gl.clearColor(0, 0, 0, 0); gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
    var eye = [0, 0.5, 4.6];
    var V = mul(RX(0.13), T(-eye[0], -eye[1], -eye[2]));
    var P = persp(0.62, W / H, 0.1, 50);

    var open = ease((u - 0.68) / 0.26);                 // 終盤に開く
    var bob = Math.sin(el * 2.4) * 0.06 * (1 - open);
    var spin = el * 2.6 + open * 1.2;
    // カプセル全体の向き: 斜めに傾けて回転
    var base = mul(T(0, 0.12 + bob, 0), mul(RY(spin), mul(RZ(1.15 - open * 0.2), RX(0.18))));

    // 影
    gl.enable(gl.BLEND); gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA); gl.disable(gl.DEPTH_TEST);
    gl.useProgram(shadowP);
    gl.bindBuffer(gl.ARRAY_BUFFER, quad.p); gl.enableVertexAttribArray(sloc.p); gl.vertexAttribPointer(sloc.p, 3, gl.FLOAT, false, 0, 0);
    gl.uniformMatrix4fv(sloc.V, false, V); gl.uniformMatrix4fv(sloc.P, false, P);
    gl.uniform3fv(sloc.c, [0, -0.95, 0]); gl.uniform2fv(sloc.sz, [1.2 + open * 0.3, 0.4 + open * 0.06]); gl.uniform1f(sloc.k, 1 - bob * 2);
    gl.drawArrays(gl.TRIANGLES, 0, 6);

    gl.enable(gl.DEPTH_TEST); gl.depthFunc(gl.LEQUAL);
    gl.disable(gl.CULL_FACE);
    var gap = open * 0.55;
    draw(bottom, mul(base, T(0, -gap * 0.55, 0)), COL_BOT, 1, 1, V, P, eye, texObj2, [0.07, 0.14, 0.23]);
    draw(top, mul(base, T(0, 0.06 + gap * 0.55, 0)), COL_TOP, 1, 1, V, P, eye);

    // 粒(開いたあとに飛び出す)
    if (open > 0.02) {
      for (var i = 0; i < grains.length; i++) {
        var q = grains[i], d = open * q.sp;
        var gx = q.d[0] * d * 0.95, gy = 0.1 + q.d[1] * d * 0.55 - d * d * 0.12, gz = q.d[2] * d * 0.7;
        var a = Math.min(1, open * 3);
        draw(grain, mul(T(gx, gy, gz), mul(S(q.s * (0.4 + open * 0.6)), RY(el * 3 + i))), q.c, 0, a, V, P, eye);
      }
    }
    if (u < 1 || running) raf = requestAnimationFrame(frame);
  }

  api.start = function (ms) {
    dur = Math.max(600, (ms || 2400) - 150);
    section.classList.add('has3d');
    canvas.hidden = false;
    running = true; t0 = performance.now();
    cancelAnimationFrame(raf); raf = requestAnimationFrame(frame);
  };
  api.stop = function () { running = false; cancelAnimationFrame(raf); };
  api.ready = true;
})();
</script>
</body>
