      if (/\s$/.test(cur) || /^\s/.test(nx)) return false;
      if (/^[「『]/.test(nx) && acc >= 2 && !/[「『(（]$/.test(cur)) return true;   // 括弧の前で切れる
      if (/^[、。,.\uFF01\uFF1F!?」』)）…ー〜~]/.test(nx)) return false;   // 行頭に来てはいけないもの
      if (/[「『(（]$/.test(cur)) return false;                       // 行末に来てはいけないもの
      if (/^[、。\uFF01\uFF1F!?]$/.test(cur)) return true;
      if (cur === '・') return true;
      if (PART[cur] && /^[ぁ-ん]$/.test(prev || '')) return false;     // 「と|って」のように、動詞・語の途中の助詞では切らない
      if (PART[cur] && !PART[nx] && !/^[ぁ-ん]$/.test(nx) && !/^(いえ|いう|いっ|いわ)/.test(nx)) return true;
      if (acc >= 4 && cur.length >= 2 && nx.length >= 2 && /^[一-龥ァ-ヶー]/.test(nx) && !PART[cur]) return true; // 長い複合語(1文字の語の直後は切らない)
      if (acc >= 9 && cur.length >= 2 && nx.length >= 2) return true;   // 切れ目のない長い連なりは、語の境目で切る
      if (acc >= 10 && !/^[ぁ-ん]$/.test(cur)) return true;            // それでも長いときの最後の手段(語の途中は避ける)
