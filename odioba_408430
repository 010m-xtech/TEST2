/* ===== 3D(診断中のカプセル) ===== */
.pill3d { display: block; width: 100%; max-width: 360px; height: 190px; margin: 2px auto 0; }
.loading.has3d .ecg { display: none; }
@media (max-width: 480px) { .pill3d { height: 170px; } }

/* ===== 紙の診断書(紙の目・端の影) ===== */
