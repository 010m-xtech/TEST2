            <rect x="-.5" y="157.5" width="341" height="18" rx="4.5" fill="none" stroke="rgba(17,35,58,.45)"/>
            <g class="g-screw" transform="translate(14 166.5)"><circle r="5.2" fill="url(#gScrew)" stroke="rgba(17,35,58,.5)" stroke-width=".8"/><path d="M-3 -.6 H3 M-.6 -3 V3" stroke="rgba(17,35,58,.6)" stroke-width="1.3" transform="rotate(20)"/></g>
            <g class="g-screw" transform="translate(326 166.5)"><circle r="5.2" fill="url(#gScrew)" stroke="rgba(17,35,58,.5)" stroke-width=".8"/><path d="M-3 -.6 H3 M-.6 -3 V3" stroke="rgba(17,35,58,.6)" stroke-width="1.3" transform="rotate(-35)"/></g>

            <!-- 軸 -->
            <circle cx="172" cy="163.5" r="15" fill="rgba(17,35,58,.38)" filter="url(#gBlur)"/>
            <circle class="hub" cx="170" cy="160" r="13.5" fill="url(#gHub)" stroke="#4C565C" stroke-width="1"/>
            <circle cx="170" cy="160" r="9" fill="none" stroke="rgba(17,35,58,.25)" stroke-width="1"/>
            <circle class="hub-dot" cx="170" cy="160" r="4"/>
            <circle cx="166.2" cy="155.8" r="2.6" fill="#fff" opacity=".85"/>
          </svg>
        </div>
        <div class="pct">
          <div class="cap" id="rCap"></div>
          <div class="num"><span id="rPct">0</span><small>%</small></div>
          <div class="bar"><i id="rBar"></i></div>
        </div>
      </div>

      <p class="r-body" id="rBody"></p>

      <div class="shop-rx bag" id="shopRx" hidden>
        <div class="bag-crimp" aria-hidden="true"></div>
        <div class="bag-head">
          <span class="bag-kind">内服薬</span>
          <span class="bag-to"><small>お名前</small><b>あなた</b><small>様</small></span>
        </div>
        <p class="shop-rx-name" id="shopRxName"></p>
        <div class="shop-rx-body">
          <span class="bag-window" id="shopRxWin" hidden><img class="shop-rx-photo" id="shopRxPhoto" alt="" hidden></span>
          <div class="shop-rx-text">
            <p class="shop-rx-note" id="shopRxNote"></p>
            <p class="shop-rx-order" id="shopRxOrder"></p>
          </div>
        </div>
        <dl class="bag-usage">
          <div><dt>用法</dt><dd class="nw">温かいうちに、ゆっくり服用</dd></div>
          <div><dt>用量</dt><dd class="nw">1回1皿（おかわり可）</dd></div>
        </dl>
        <div class="bag-foot"><svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><rect x="7" y="2" width="6" height="16" rx="1.5" fill="currentColor"/><rect x="2" y="7" width="16" height="6" rx="1.5" fill="currentColor"/></svg><span id="shopRxShop"></span></div>
      </div>

      <div class="gapcard">
        <div class="gap-line">
          <div class="gap-tile"><small>自己申告</small><b id="gapSelfV"></b></div>
          <span class="gap-arrow" aria-hidden="true">→</span>
          <div class="gap-tile"><small>実測</small><b id="gapRealV"></b></div>
          <span class="gap-badge" id="gapBig"></span>
        </div>
        <p class="gap-msg" id="gapMsg"></p>
      </div>




      <div class="actions">
        <button type="button" class="btn btn-primary block" id="btnAgain">もういちど診断する</button>
