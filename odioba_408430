  .count { font-size: 22px; }
  .ticks { margin-bottom: 12px; }
  .ticks i { height: 10px; }
  .qtext { font-size: clamp(21px, 5.6vw, 25px); margin-bottom: 12px; min-height: 1.5em; line-height: 1.45; }
  .gloss { margin: -2px 0 10px; padding: 6px 12px; font-size: 14px; line-height: 1.5; }
