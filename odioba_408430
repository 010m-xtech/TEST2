        <div class="cap">ただいまの診察番号</div>
        <div class="no" id="boardNo">000</div>
        <div class="in">診察室へ、お入りください</div>
      </div>
      <svg class="ecg" viewBox="0 0 600 60" aria-hidden="true"><path pathLength="100" d="M0 32 H110 l8 -6 l10 6 H190 l7 6 l11 -32 l13 50 l9 -24 H320 l9 -7 l12 7 H430 l7 6 l11 -32 l13 50 l9 -24 H600"></path></svg>
      <p class="msg" id="loadMsg" aria-live="polite"></p>
    </section>

    <!-- 診断書 -->
    <section class="screen paper" id="s-result" hidden>
      <div class="confetti" id="confetti" aria-hidden="true"></div>
      <div class="r-head">
        <div class="r-clinic" id="rClinic"></div>
        <h2 id="rTitleLabel"></h2>
        <div class="r-meta"><span id="rNo"></span><span id="rDate"></span></div>
      </div>

      <div class="verdict-top">
        <div class="stamp" id="stamp" aria-hidden="true"><small>判定</small><b id="stampLetter">A</b></div>
        <div class="vt">
          <p class="sub" id="rSub"></p>
          <h3 id="rHead"></h3>
          <p class="nick" id="rNick"><span class="label">二つ名</span><b id="rNickV"></b></p>
        </div>
      </div>

      <div class="meter">
        <div class="gauge-box">
          <svg class="gauge" id="gauge" viewBox="-2 -12 344 200" role="img" aria-label="おぢさん度メーター">
            <defs>
              <radialGradient id="gFace" cx="170" cy="150" r="160" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#FFFFFC"/><stop offset=".6" stop-color="#FAF7EF"/><stop offset=".9" stop-color="#EFE9DC"/><stop offset="1" stop-color="#DCD4C2"/>
              </radialGradient>
              <linearGradient id="gChrome" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#FFFFFF"/><stop offset=".08" stop-color="#E9EDF0"/><stop offset=".2" stop-color="#9BA4AB"/>
                <stop offset=".32" stop-color="#F7F9FA"/><stop offset=".5" stop-color="#C3CAD0"/><stop offset=".68" stop-color="#727C84"/>
                <stop offset=".86" stop-color="#D9DEE2"/><stop offset="1" stop-color="#8C959C"/>
              </linearGradient>
              <linearGradient id="gChromeSide" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#fff" stop-opacity=".55"/><stop offset=".35" stop-color="#fff" stop-opacity="0"/>
                <stop offset=".7" stop-color="#11233A" stop-opacity="0"/><stop offset="1" stop-color="#11233A" stop-opacity=".35"/>
              </linearGradient>
              <linearGradient id="gBase" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#F4F6F7"/><stop offset=".18" stop-color="#D3D9DD"/><stop offset=".55" stop-color="#AEB6BC"/><stop offset="1" stop-color="#7A848B"/>
              </linearGradient>
              <linearGradient id="gGlass" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#fff" stop-opacity=".5"/><stop offset=".38" stop-color="#fff" stop-opacity=".1"/><stop offset=".40" stop-color="#fff" stop-opacity="0"/>
                <stop offset=".9" stop-color="#fff" stop-opacity="0"/><stop offset="1" stop-color="#fff" stop-opacity=".12"/>
              </linearGradient>
              <linearGradient id="gNeedle" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#4A6382"/><stop offset=".48" stop-color="#1F3550"/><stop offset=".52" stop-color="#0B1726"/><stop offset="1" stop-color="#13263D"/>
              </linearGradient>
              <radialGradient id="gHub" cx=".36" cy=".3" r=".85">
                <stop offset="0" stop-color="#FFFFFF"/><stop offset=".25" stop-color="#E3E8EB"/><stop offset=".6" stop-color="#9AA3AA"/><stop offset="1" stop-color="#4E585F"/>
              </radialGradient>
              <radialGradient id="gScrew" cx=".35" cy=".3" r=".9">
                <stop offset="0" stop-color="#FFFFFF"/><stop offset=".45" stop-color="#C2C9CE"/><stop offset="1" stop-color="#5E686F"/>
              </radialGradient>
              <filter id="gBlur" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="2.2"/></filter>
              <filter id="gSoft" x="-5%" y="-5%" width="110%" height="110%"><feGaussianBlur stdDeviation=".5"/></filter>
              <filter id="gInner" x="-10%" y="-10%" width="120%" height="120%"><feGaussianBlur stdDeviation="6"/></filter>
              <filter id="gGrain" x="0" y="0" width="100%" height="100%">
