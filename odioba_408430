        <div class="start-btns">
          <button type="button" class="btn btn-primary block start-btn" data-mode="oji">おぢさん度を測る</button>
          <button type="button" class="btn btn-warm block start-btn" data-mode="oba">おばさん度を測る</button>
          <button type="button" class="btn btn-ghost block start-btn" data-mode="both">どっちも気になる</button>
        </div>
      </div>
      <ul class="facts">
        <li>全4問</li>
        <li>約1分</li>
        <li>質問は毎回ちがう</li>
        <li>ことば解説つき</li>
      </ul>
    </section>

    <!-- 自己申告 -->
    <section class="screen paper" id="s-self" hidden>
      <span class="tag">まずは自己申告</span>
      <h2 class="self-title" id="selfTitle"></h2>
      <p class="self-sub fixed-lines" data-fit="13"><span class="ln">診断のあとで、答え合わせをします。</span><br><span class="ln">盛らずに、正直にどうぞ。</span></p>
      <div class="self-big"><span id="selfOut">30</span><small>%</small></div>
      <div class="self-opts" id="selfOpts" role="group" aria-label="自己申告のパーセント">
        <button type="button" class="self-opt" data-v="10">10%</button>
        <button type="button" class="self-opt" data-v="30">30%</button>
        <button type="button" class="self-opt" data-v="50">50%</button>
        <button type="button" class="self-opt" data-v="70">70%</button>
        <button type="button" class="self-opt" data-v="90">90%</button>
      </div>
      <div class="self-scale"><span>ぜんぜん</span><span>ばっちり</span></div>
      <div class="self-nav">
        <button type="button" class="btn btn-ghost" id="btnSelfBack">戻る</button>
        <button type="button" class="btn btn-primary" id="btnSelf">この数字で申告する</button>
      </div>
      <p class="fine">タッチして、数字を選んでください。</p>
    </section>

    <!-- 問診 -->
    <section class="screen paper" id="s-quiz" hidden>
      <div class="form-title" aria-hidden="true"><b>問診票</b><span id="formClinic">南風クリニック</span></div>
      <div class="quiz-head">
        <span class="dept"><span class="label">診察科</span><b id="qDept"></b></span>
        <span class="count" id="qNum"></span>
      </div>
      <div class="ticks" id="ticks" aria-hidden="true"></div>
      <div class="qbox" id="qbox">
        <h2 class="qtext" id="qText"></h2>
        <div class="answers" id="answers" role="group" aria-label="回答"></div>
        <div class="note" id="note" aria-live="polite">
          <span class="who" id="who">おぢ川先生</span>
          <p id="quip" class="empty">選ぶと、先生がひとこと添えます。</p>
        </div>
      </div>
      <div class="nav">
        <button type="button" class="btn btn-ghost" id="btnBack">戻る</button>
        <button type="button" class="btn btn-primary" id="btnNext" disabled>次へ</button>
      </div>
        <p class="gloss" id="qGloss" hidden><b>ことば解説</b><span id="qGlossText"></span></p>
      <p class="fine fixed-lines" data-fit="12"><span class="ln">盛らずに、正直にお答えください。</span><br><span class="ln">しばらく操作が無いと、最初の画面に戻ります。</span></p>
    </section>

    <!-- 診断中 -->
