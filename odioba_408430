  .note p { display: block; font-size: 15px; line-height: 1.5; }
  .nav { margin-top: 12px; }
  #s-quiz .fine { display: none; }
  .in-quiz .clinic-bar { display: none; }   /* 質問中は上のバーを隠して、縦の余裕をつくる */
  .in-quiz { padding-top: 10px; }
  #s-quiz.paper { padding: 10px 12px 12px; }
  .quiz-head { margin-bottom: 4px; }
  .ticks { margin-bottom: 8px; }
  .qtext { margin-bottom: 18px; }
  .answers { gap: 12px; }
  .ans { min-height: 68px; padding: 6px 14px; font-size: clamp(20px, 5.8vw, 23px); }
  .gloss { margin: 12px 0 0; padding: 8px 12px; font-size: 16px; line-height: 1.5; }
  .note { margin-top: 14px; padding: 9px 12px; }
  .note .who { font-size: 14px; }
  .note p { font-size: 17px; line-height: 1.5; }
  .nav { margin-top: 14px; }
